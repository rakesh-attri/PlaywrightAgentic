# No credentials are needed for the local demo.
OPENAI_API_KEY=
SFQA_MODEL=
SFQA_EMBED_MODEL=text-embedding-3-small
SFQA_API_BASE=
# Chroma TS client connects to a persistent server or Chroma Cloud.
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
CHROMA_SSL=false
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
CHROMA_API_KEY=
# JWT subject is a preauthorized, UI-enabled sandbox user.
SF_LOGIN_URL=https://test.salesforce.com
SF_JWT_AUDIENCE=https://test.salesforce.com
SF_CLIENT_ID=
SF_USERNAME=
SF_JWT_PRIVATE_KEY_PATH=.auth/server.key
# My Domain or Experience site URL, including site prefix where applicable.
SF_BASE_URL=https://YOUR-DOMAIN--sandbox.sandbox.my.salesforce.com
SF_START_PATH=/lightning/page/home
SF_ALLOWED_ORIGINS=https://YOUR-DOMAIN--sandbox.sandbox.my.salesforce.com
# Required authenticated-only locator, e.g. a stable landmark from your org.
SF_AUTH_MARKER_BY=role
SF_AUTH_MARKER_NAME=Navigation
SF_AUTH_MARKER_ROLE=navigation
SF_AUTH_MAX_AGE_MINUTES=30
SFQA_JUDGE_MODEL=
DEEPEVAL_TELEMETRY_OPT_OUT=YES
