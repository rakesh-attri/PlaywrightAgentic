{
  "name": "playwright-agentic-salesforce",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "npm ci && playwright install chromium && npm run typecheck",
    "sfqa": "node --import tsx src/cli.ts",
    "demo": "node --import tsx src/cli.ts build examples/account-story.json --mode demo --execute",
    "test": "vitest run unit",
    "typecheck": "tsc --noEmit",
    "auth": "node --import tsx src/cli.ts auth",
    "chroma": "chroma run --host 127.0.0.1 --path .state/chroma --port 8000",
    "check:chroma": "node --import tsx scripts/check-chroma.ts",
    "check:reports": "node --import tsx scripts/check-reports.ts",
    "format": "prettier --write src unit scripts *.ts *.json",
    "mcp": "node --import tsx src/tool-server.ts",
    "codex:configure": "node --import tsx scripts/configure-codex.ts",
    "agents:init": "playwright init-agents --loop=codex",
    "demo:chroma": "node --import tsx src/cli.ts build examples/account-story.json --mode demo --execute --chroma"
  },
  "dependencies": {
    "@langchain/core": "1.1.31",
    "@langchain/langgraph": "1.0.15",
    "@langchain/openai": "1.2.9",
    "@langchain/textsplitters": "1.0.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "1.64.1",
    "chromadb": "3.5.0",
    "commander": "15.0.0",
    "dotenv": "18.0.9",
    "yaml": "2.9.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@sentry/node": "11.10.0",
    "@types/node": "26.6.6",
    "deepeval": "0.9.9",
    "prettier": "3.9.10",
    "reporting-labs": "0.6.24",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@langchain/langgraph-checkpoint": "1.0.0"
  }
}
